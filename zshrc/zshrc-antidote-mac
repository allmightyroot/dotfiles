# zmodload zsh/zprof
# ~/.zshrc

# .zprofile/.zshenv are left as empty stubs on this Mac - everything is
# consolidated here instead, so this PATH setup is load-bearing.
eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$PATH"

# oh-my-zsh's lib/plugins assume ZSH_CACHE_DIR is set up (normally done by
# oh-my-zsh.sh itself, which this antidote-based setup never sources). Without
# it, e.g. the kubectl plugin's background completion refresh resolves
# TMPPREFIX to the bogus path "/completions/_kubectl", and zsh's process
# substitution crashes (double-free in prefork/getoutputfile) trying to
# create a temp file there - the "process substitution failed" + malloc
# crash seen on shell startup. Set it up the same way oh-my-zsh.sh does.
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-$HOME/.cache/oh-my-zsh}"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"

# Clone antidote if necessary.
[[ -e ${ZDOTDIR:-~}/.antidote ]] ||
  git clone https://github.com/mattmc3/antidote.git ${ZDOTDIR:-~}/.antidote

# Source antidote.
source ${ZDOTDIR:-~}/.antidote/antidote.zsh


# Optimized compinit - only run once per day
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-~}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Load all plugins from static file
source ~/.zsh_plugins.zsh

# Alias to regenerate static plugin file
alias antidote-update='source ${ZDOTDIR:-~}/.antidote/antidote.zsh && antidote bundle <${ZDOTDIR:-~}/.zsh_plugins.txt >${ZDOTDIR:-~}/.zsh_plugins.zsh && echo "Plugins regenerated! Restart your shell or run: source ~/.zshrc"'

fastfetch

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
source /Users/chris/.config/op/plugins.sh

alias ncdu="gdu-go"
