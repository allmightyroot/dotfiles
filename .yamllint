---
extends: default

rules:
  line-length:
    max: 120
  # ansible-lint bundles its own yamllint expectations and refuses to run
  # its yaml checks unless a custom config matches these exactly.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
