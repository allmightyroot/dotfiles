#!/usr/bin/env bash
# Delete branches on the mirrors that are already merged into the default
# branch on the primary.
#
# A branch qualifies only if its tip is an ancestor of origin/<default>
# (nothing unique would be lost). It never touches the default branch, never
# touches the primary (first push URL = origin's fetch URL), and skips any
# branch whose tip commit isn't known locally. Branches merged by squash or
# rebase aren't ancestors, so they're listed as kept; delete those by hand
# after checking.
#
# Dry run unless --yes. Run it yourself: Claude Code's permission classifier
# blocks remote branch deletion by design.
#
# Usage (inside a repo):
#   mirror-prune-branches         show what would be deleted
#   mirror-prune-branches --yes   delete it

set -euo pipefail

remote=origin
yes=0
[ "${1:-}" = "--yes" ] && yes=1

git fetch --quiet "$remote"

default=$(git symbolic-ref --short "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s|^$remote/||" || true)
default="${default:-main}"
primary=$(git remote get-url "$remote")

while IFS= read -r url; do
  [ "$url" = "$primary" ] && continue
  echo "== $url"
  found=0
  while read -r sha ref; do
    [ -n "${ref:-}" ] || continue
    name="${ref#refs/heads/}"
    [ "$name" = "$default" ] && continue
    found=1
    if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
      echo "   keep    $name (tip $sha not known locally)"
    elif git merge-base --is-ancestor "$sha" "refs/remotes/$remote/$default"; then
      if [ "$yes" -eq 1 ]; then
        git push --quiet "$url" --delete "$name" && echo "   deleted $name"
      else
        echo "   would delete $name (merged into $default)"
      fi
    else
      echo "   keep    $name (not merged into $default)"
    fi
  done < <(git ls-remote --heads "$url")
  [ "$found" -eq 1 ] || echo "   no other branches"
done < <(git remote get-url --push --all "$remote")

if [ "$yes" -eq 0 ]; then
  echo
  echo "(dry run; add --yes to delete)"
fi
